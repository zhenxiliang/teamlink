  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "server": "node bin/teamlink-server.js start",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
